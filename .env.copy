# Template of .env (copy it to .env and fill it in; .env itself is never committed).
# Deployed, set these as environment variables of the web API and the OCR worker instead of a .env file.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reimbursement
DB_USER=
DB_PASSWORD=

# Hosts POST /api/reimbursements may download receipt files from, host or host:port, comma-separated.
# Local: 127.0.0.1:5000 (the backend serving the dummy files). Deployed: Darwinbox's file host(s). Never leave it
# empty outside local development (empty allows any host).
ATTACHMENT_HOSTS=127.0.0.1:5000

# Google Cloud Storage bucket for the receipt files (private). Empty: files go to backend/storage/ (local).
# No login or key variable: the access comes from Application Default Credentials.
#   Deployed on GCP: the service account the web API and the OCR worker run as; give it Storage Object Creator and
#   Storage Object Viewer on the bucket (the worker only needs Viewer).
#   On a laptop: install the gcloud CLI and run `gcloud auth application-default login` with an account that has access.
# Without access, new reports are refused (503, nothing saved) and the files can't be shown or read by the OCR.
GCS_BUCKET=

# Claude API key for the OCR worker: the Claude Code CLI it runs uses this key instead of a login.
# Deployed: the organization's API key (with access to claude-haiku-5-5). Empty: your `claude auth login` (local).
ANTHROPIC_API_KEY=
