# Secrets: never commit. .env.copy is the committed template (variable names only, no real values).
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node (website)
node_modules/
dist/
*.tsbuildinfo

# Generated by main.py (OCR output, reports, validation logs). Re-create it by running the pipeline.
results/
results_*/
comparison.txt

# The local file storage (development, when GCS_BUCKET is not set): receipt files received by the API.
backend/storage/

# Receipt photos: large, and they can contain personal data, so only a small sample set is kept in git.
# Share the rest through the team's storage. (backend/jobs/bbm_ocr/ground_truth/gt.json is small and stays in git.)
# To add another sample, add a line "!backend/jobs/bbm_ocr/images/<file>" below.
backend/jobs/bbm_ocr/images/*
!backend/jobs/bbm_ocr/images/1.jpeg
